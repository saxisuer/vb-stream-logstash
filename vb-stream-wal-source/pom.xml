<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.vastdata</groupId>
        <artifactId>vb-stream-logstash</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>vb-stream-wal-source</artifactId>

    <!-- 模块定位：PostgreSQL WAL 直解源（spec §4）——绕过逻辑解码输出插件，从 WAL 物理流
         直接解析变更记录。本 pom 仅最小依赖面（pgjdbc + slf4j + lz4-java[TOAST lz4 解压]），
         布局/解析/接收组件在此之上搭建。 -->
    <dependencies>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j-api.version}</version>
        </dependency>
        <!-- lz4 解压（ToastAssembler 的 lz4 压缩 TOAST/行内 varlena 值面）——PG 侧
             toast_decompress_datum 走 liblz4 裸 block 格式（LZ4_decompress_safe），
             lz4-java 的 safeDecompressor 同格式（JNI 优先、纯 Java 安全回落，零传递依赖）。
             运行依赖面承诺相应从 pgjdbc+slf4j 扩为 +lz4-java。 -->
        <dependency>
            <groupId>org.lz4</groupId>
            <artifactId>lz4-java</artifactId>
            <version>${lz4-java.version}</version>
        </dependency>
        <!-- logback-classic：slf4j 运行时绑定（2026-10-09 自 test-scope 提升——此前 main 面
             直接跑冒烟 Main 因无绑定 NOP 静默零日志）。runtime 不进编译面；库形态宿主
             （reader/连接器）自带绑定时以其 classpath 为准——本模块随 jar 附带的
             logback.xml 仅在无更高优先级配置时生效（logback.configurationFile 可覆盖）。 -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- 双路对拍（Task 8）：engine 管线仅 test-scope 引入——in-process 起 PgReplicationSession +
             TransactionAssembler + ConsoleRenderer 作对拍基准路。运行依赖面仍是 pgjdbc + slf4j-api
             （依赖方向不变：将来 engine 依赖本模块，不是反过来）；engine 的编译依赖
             （chronicle-queue/HdrHistogram/logback-classic）经 test classpath 传递可用。
             Chronicle mmap 所需的 surefire argLine 的 add-opens 五件继承自 parent pom 的
             surefire 配置（与 engine 模块同源，engine pom 自身未重复声明）。 -->
        <dependency>
            <groupId>org.vastdata</groupId>
            <artifactId>vb-stream-engine</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 本模块对抗性 IT（WalAdversarialIT 等）与离线 *Test 同属 mvn test 面（需 Docker，
                 与仓库引擎模块 IT 同惯例不设手动档）；surefire 默认 includes 只认 *Test，此处显式扩 *IT。
                 其余配置（argLine/systemPropertyVariables）继承 parent。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
