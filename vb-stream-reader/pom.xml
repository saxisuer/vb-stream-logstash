<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.vastdata</groupId>
        <artifactId>vb-stream-logstash</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>vb-stream-reader</artifactId>

    <!-- 模块定位：debezium-embedded 宿主冒烟应用——DebeziumEngine.create(Connect.class) 加载
         vb-stream-connector-postgres-stream 的 PostgresStreamConnector，ChangeConsumer 回调
         逐条 SourceRecord 输出 slf4j 日志。依赖方向：reader → connector（→ 引擎零依赖,不受 D2 约束）。 -->
    <dependencies>
        <!-- 自研连接器:pgjdbc/chronicle-queue/debezium-connector-postgres 随其 compile 传递；
             该模块的 connect-api/slf4j-api 是 provided 不传递——由下方两项显式补齐 -->
        <dependency>
            <groupId>org.vastdata</groupId>
            <artifactId>vb-stream-connector-postgres-stream</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- VBFG 契约层:file 输出形态的格式读写(file 包与 ReaderFileSinkIT 经此传递依赖) -->
        <dependency>
            <groupId>org.vastdata</groupId>
            <artifactId>vb-stream-file-format</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- debezium-embedded:async 引擎(3.x 唯一实现,ConvertingAsyncEngineBuilderFactory 经
             ServiceLoader 发现)+ connect-runtime(FileOffsetBackingStore)/connect-json/connect-file
             compile 传递;注意其传递 slf4j-api 是 1.7.36,由下方显式声明压回 2.x -->
        <dependency>
            <groupId>io.debezium</groupId>
            <artifactId>debezium-embedded</artifactId>
            <version>${debezium.version}</version>
        </dependency>

        <!-- connect-api:主代码直接 import SourceRecord/Struct;传递版本 4.3.0 与根 pin 一致,
             显式声明做直接依赖治理 -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>connect-api</artifactId>
            <version>${kafka.connect-api.version}</version>
        </dependency>

        <!-- slf4j-api 显式 2.0.17:压掉 debezium 传递的 1.7.36(与 logback 1.5 绑定不兼容——
             1.7.x 找 StaticLoggerBinder,logback 1.3+ 无 → NOP 静默无日志;connector 模块 pom
             记过同一坑);宿主模块运行期需要它,保持 compile -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j-api.version}</version>
        </dependency>

        <!-- 宿主随包发 slf4j 绑定(与 vb-stream-engine pom 同姿态) -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- it 包的集成测试以 *IT 命名(区别于离线单测 *Test),默认 includes
                         不含该模式——显式补全(默认四模式照抄 + IT,与 connector 模块同款),
                         使 mvn test 单命令跑全部;根 pom 的 add-opens argLine 原样继承 -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
