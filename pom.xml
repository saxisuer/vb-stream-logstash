<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.vastdata</groupId>
    <artifactId>vb-stream-logstash</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>vb-stream-engine</module>
        <module>vb-stream-connector-postgres-stream</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <postgresql.version>42.7.13</postgresql.version>
        <chronicle-queue.version>2026.6</chronicle-queue.version>
        <debezium.version>3.6.1.Final</debezium.version>
        <kafka.connect-api.version>4.3.0</kafka.connect-api.version>
        <slf4j-api.version>1.7.36</slf4j-api.version>
        <hdrhistogram.version>2.2.2</hdrhistogram.version>
        <logback.version>1.5.18</logback.version>
        <junit-jupiter.version>6.1.3</junit-jupiter.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <jmh.version>1.37</jmh.version>
        <maven-build-helper-plugin.version>3.6.0</maven-build-helper-plugin.version>
    </properties>

    <build>
        <plugins>
            <!-- Surefire 3.6.0+ 才能以 JUnit Platform 作为统一测试执行机制（JUnit 6 必需） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <!-- Chronicle Queue 在 Java 17+ 需开放内部包（mmap 经反射调 sun.nio.ch.FileChannelImpl.map0），
                         官方支持说明见 https://chronicle.software/chronicle-support-java-17 -->
                    <argLine>--add-opens java.base/jdk.internal.ref=ALL-UNNAMED --add-opens java.base/sun.nio.ch=ALL-UNNAMED --add-opens jdk.unsupported/sun.misc=ALL-UNNAMED --add-opens java.base/sun.nio.fs=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
